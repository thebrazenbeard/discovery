{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/discovery/schemas/research_cut_v1.schema.json",
  "title": "Discovery Research Cut V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "inventory_binding", "observations"],
  "properties": {
    "schema_version": {"const": "DISCOVERY_RESEARCH_CUT_V1"},
    "status": {"type": "string", "minLength": 1},
    "inventory_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_date", "total_count", "public_count", "all_names_sha256"],
      "properties": {
        "observed_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "total_count": {"type": "integer", "minimum": 1},
        "public_count": {"type": "integer", "minimum": 1},
        "all_names_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repo", "visibility", "observed_ref", "source_locator", "evidence_state",
          "summary", "mechanic_tags", "candidate_family_inputs", "boundaries",
          "uncertainties", "promotion_ceiling"
        ],
        "properties": {
          "repo": {"type": "string", "minLength": 1},
          "visibility": {"const": "PUBLIC"},
          "observed_ref": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "source_locator": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["OBSERVED", "HYPOTHESIS"]},
          "summary": {"type": "string", "minLength": 1},
          "mechanic_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "candidate_family_inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "uncertainties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "promotion_ceiling": {"enum": ["OBSERVED_ONLY", "HYPOTHESIS_ONLY"]}
        }
      }
    }
  }
}
